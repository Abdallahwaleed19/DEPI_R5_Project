# SILLA Data Engineering — Environment Variables
# Copy this file to .env and fill in your values. Never commit .env.

# General
PROJECT_ENV=development         # development | staging | production
LOG_LEVEL=INFO

# Database
DB_PATH=database/silla.db       # Path to SQLite database file

# Scraping
REQUEST_DELAY_SECONDS=2.0       # Polite delay between HTTP requests
USER_AGENT="SILLA-DataBot/1.0 (DEPI Egypt; contact: team@example.com)"

# External API Keys (if needed in future)
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
